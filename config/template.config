includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    dataset_id = 'cohort-01'
    mzml_csv = '/path/to/mzml.csv'
    idxml_csv = '/path/to/idxml.csv'
    fractionated = true
    idxml_score_type = 'ProtLoom PEP'
    easypqp_score_type = 'PEP'
    psm_tsv = '/path/to/cohort-psm.tsv'
    peptide_tsv = '/path/to/cohort-peptides.tsv'
    output_dir = '/path/to/output'
    save_intermediate_files = false
}

methods.setup()

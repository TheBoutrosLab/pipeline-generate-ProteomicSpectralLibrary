includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'ECOLI-DIA'
    mzml_csv = "${projectDir}/test/test-integration-EasyPQP/mzml.csv"
    idxml_csv = "${projectDir}/test/test-integration-EasyPQP/idxml.csv"
    fractionated = true
    psm_tsv = "${TEST_DATA_DIR}/ecoli_dia/validate-ProteomicPSM-fractionated/validate-ProteomicPSM-2.4.1/ecoli_dia/ProteinProphet/output/ecoli_dia-psm.tsv"
    peptide_tsv = "${TEST_DATA_DIR}/ecoli_dia/validate-ProteomicPSM-fractionated/validate-ProteomicPSM-2.4.1/ecoli_dia/ProteinProphet/output/ecoli_dia-peptides.tsv"
    save_intermediate_files = true
    idxml_score_type = 'Posterior Error Probability_score'
    easypqp_score_type = 'PEP'
}

params.mzml_csv = csvEnvironmentExpander.prepareInputCsv(
    params.mzml_csv, 'test-integration-EasyPQP-mzml', launchDir
)
params.idxml_csv = csvEnvironmentExpander.prepareInputCsv(
    params.idxml_csv, 'test-integration-EasyPQP-idxml', launchDir
)

methods.setup()
